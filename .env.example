# Copy to .env and edit. scripts/start.sh loads this file.

# Required once. Paper will not boot until this is true.
EULA=true

# Heap. Use a size (2G, 4G) or auto (about 20% of RAM, min 1G, max 4G).
MEMORY=auto

# Java Edition TCP port
JAVA_PORT=25565

# Bedrock Edition UDP port (Geyser)
BEDROCK_PORT=19132

MAX_PLAYERS=20
MOTD=Minecraft Infinite
VIEW_DISTANCE=8
SIMULATION_DISTANCE=6

# true = Mojang/Microsoft auth for Java players. Bedrock still joins via Floodgate.
ONLINE_MODE=true

# Paper Minecraft version on fill.papermc.io (current stable line).
PAPER_VERSION=26.2
# latest = newest STABLE build for PAPER_VERSION
PAPER_BUILD=latest

# Geyser / Floodgate / ViaVersion: latest from their APIs, or pin a version.
GEYSER_VERSION=latest
FLOODGATE_VERSION=latest
VIAVERSION=1
